# Environment for the hermetic E2E stack (docker-compose.e2e.yml).
#
#   cp .env.e2e.example .env.e2e     # .env.e2e is git-ignored
#   pnpm docker:e2e
#
# Every value below is a throwaway test credential for a stack that only lives
# on this machine. Do not reuse any of them anywhere real.
#
# Compose reads this file through `--env-file`, but a variable of the same name
# exported in your shell wins over it. Unset such leftovers (DATABASE_URL, ...)
# if the stack boots with surprising values.
#
# NODE_ENV (production) and PORT (3000) are fixed by docker-compose.e2e.yml.

# ── App database (the compose `db` service, not published to the host) ──
DB_NAME=envault_e2e
DB_USER=envault
DB_PASSWORD=e2e_db_pass_123
DATABASE_URL=postgresql://envault:e2e_db_pass_123@db:5432/envault_e2e

# ── Origins ─────────────────────────────────────────────────────
# Browsers and tests reach the app through the web proxy on :5173, which also
# serves /api/*, so that is the origin Better Auth has to know. :3000 is the
# api's own published port, allowed for API-level tests that bypass the proxy.
# Use `localhost`, not 127.0.0.1: the session cookie is `Secure` (production
# mode) and is only sent over plain http to the hostname `localhost`.
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Auth and encryption ─────────────────────────────────────────
BETTER_AUTH_SECRET=e2e-better-auth-secret-for-local-test-runs-only
# Sign-up is closed: this admin is created at API boot and is the account the
# tests sign in with. The password must satisfy the API's password policy or no
# admin is created: at least 12 characters, not a common password or pattern,
# and not containing the part of the email before the @ or the name "Admin".
BETTER_AUTH_ADMIN_EMAIL=e2e-admin@envault.local
BETTER_AUTH_ADMIN_PASSWORD=e2e-correct-horse-battery
# AES-256-GCM key for stored connection passwords: exactly 64 hex characters.
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# ── Redis / BullMQ ──────────────────────────────────────────────
# The base compose refuses to start Redis with an empty password.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=e2e_redis_pass_123
REDIS_TLS=false

# ── Rate limits (raised so a test run does not trip them by accident) ──
# Production defaults are 10 auth requests and 100 requests per minute and IP.
# Lower them only for the specs that exercise throttling on purpose.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10000
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=1000

# ── Backup / restore pipeline ───────────────────────────────────
# Generous so that large performance datasets are never cut short.
BACKUP_TIMEOUT_MS=1800000
RESTORE_TIMEOUT_MS=1800000

# ── Object storage: MinIO standing in for Cloudflare R2 ─────────
# R2_ENDPOINT replaces the endpoint derived from R2_ACCOUNT_ID (so that one
# stays blank) and switches the S3 client to path-style addressing. The
# credentials double as the MinIO root user, and minio-init creates the bucket.
R2_ENDPOINT=http://minio:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=e2e-access-key
R2_SECRET_ACCESS_KEY=e2e-secret-key-123
R2_BUCKET_NAME=envault-e2e
R2_PUBLIC_BASE_URL=

# ── Optional: host port overrides ───────────────────────────────
# Defaults avoid the ports of the dev stack (5432, 5434, 3306, 6379). The web
# proxy is fixed on 5173.
# E2E_API_PORT=3000
# E2E_PG_PORT=5435
# E2E_MYSQL_PORT=3307
# E2E_MINIO_PORT=9000
# E2E_MINIO_CONSOLE_PORT=9001
# The pipeline specs read E2E_PG_PORT, E2E_MYSQL_PORT and E2E_MINIO_PORT too:
# they seed the source databases and look into MinIO from the host.
#
# Playwright runner (e2e/): the defaults match the ports above, so these only
# need to be set when a port was overridden. Keep the hostname `localhost`.
# E2E_BASE_URL=http://localhost:5173
# E2E_DIRECT_API_URL=http://localhost:3000
#
# Postgres source image. The api image ships the PostgreSQL clients 14 to 18 and
# picks the one that matches the server's major, so any of those majors works
# (for example postgres:16-alpine). The default is 18.
# E2E_PG_IMAGE=postgres:18-alpine

# ── Performance suite (pnpm test:e2e:perf) ──────────────────────
# Read by the Playwright runner only; Compose ignores them. All optional, shown
# with their defaults of the "full" preset. A variable exported in the shell
# wins over this file. See docs/en/e2e-testing.md ("Performance suite").
# E2E_PERF_PRESET=full               # full, or quick: a smoke check of the whole harness
# E2E_PERF_ENGINES=postgres,mysql
# E2E_PERF_SIZES=small,medium,large  # add xlarge (about 1 GB) to opt in
# E2E_PERF_RUNS=                     # measured runs per case; unset = 20 small, 20 medium, 10 large, 3 xlarge
# E2E_PERF_QUEUE_SIZE=medium         # dataset of the simultaneous backups and restores
# E2E_PERF_QUEUE_K=1,2,4,6           # backups launched together, one case per value
# E2E_PERF_QUEUE_RESTORES=1,2        # restores launched together, one case per value
# E2E_PERF_QUEUE_RUNS=5
# E2E_PERF_UI_RUNS=20                # cold loads per page
# E2E_PERF_API_REQUESTS=100          # sequential requests per endpoint
