# App & Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Build-time only (apps/web/Dockerfile takes it as an ARG and bakes it into
# the bundle). Leave it unset with the compose files in this repo: the API
# publishes no host port, and both nginx (prod) and the vite proxy (dev)
# serve it same-origin under /api — no CORS, no cross-site cookies.
# Set it only when the frontend and the API live on different origins, and
# then it must be a bare origin with no path (src/config.ts throws otherwise).
VITE_API_URL=https://api.example.com

# Security (CSP & AES-256-GCM)
CSP_HEADER_NAME=Content-Security-Policy-Report-Only
# Generate with: openssl rand -hex 32 (must be 64 hex characters)
ENCRYPTION_KEY=<64-hex-characters>

# Database (PostgreSQL)
DB_NAME=envault
DB_USER=envault
DB_PASSWORD=<postgres-password>
# Use 'db' for Docker network, 'localhost' for local pnpm dev
DATABASE_URL=postgresql://envault:<postgres-password>@db:5432/envault

# Auth (Better Auth)
BETTER_AUTH_SECRET=<random-32-char-secret>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ADMIN_EMAIL=admin@envault.local
BETTER_AUTH_ADMIN_PASSWORD=<min-8-chars>

# Auth Rate Limiting
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
AUTH_RATE_MAX_KEYS=10000
AUTH_RATE_SWEEP_INTERVAL_MS=60000

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<bucket-name>
R2_PUBLIC_BASE_URL=https://<your-r2-public-url>/
 
# Restore Execution Timeout (milliseconds)
# Defaults to 1800000 (30 minutes) to support large dumps up to 5 GB.
RESTORE_TIMEOUT_MS=1800000
