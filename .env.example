# App & Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Build-time only (apps/web/Dockerfile takes it as an ARG and bakes it into
# the bundle). Leave it unset with the compose files in this repo: the API
# publishes no host port, and both nginx (prod) and the vite proxy (dev)
# serve it same-origin under /api — no CORS, no cross-site cookies.
# Set it only when the frontend and the API live on different origins, and
# then it must be a bare origin with no path (src/config.ts throws otherwise).
VITE_API_URL=https://api.example.com

# Security (CSP & AES-256-GCM)
CSP_HEADER_NAME=Content-Security-Policy
# Generate with: openssl rand -hex 32 (must be 64 hex characters)
ENCRYPTION_KEY=<64-hex-characters>

# Database (PostgreSQL)
DB_NAME=envault
DB_USER=envault
DB_PASSWORD=<postgres-password>
# Use 'db' for Docker network, 'localhost' for local pnpm dev
DATABASE_URL=postgresql://envault:<postgres-password>@db:5432/envault

# Auth (Better Auth)
BETTER_AUTH_SECRET=<random-32-char-secret>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ADMIN_EMAIL=admin@envault.local
# Used only to create the first admin. 12 to 128 characters; a passphrase of
# unrelated words is best. Refused: common passwords (password1234), patterns
# (123456789012, qwertyuiop, abcabcabcabc) and anything containing the part of
# the email before the @ or the word "admin" (the seeded account is named
# "Admin"). A refused password is logged at boot and no admin is created.
BETTER_AUTH_ADMIN_PASSWORD=<12-128-chars-passphrase>

# Auth Rate Limiting
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
AUTH_RATE_MAX_KEYS=10000
AUTH_RATE_SWEEP_INTERVAL_MS=60000

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<bucket-name>
R2_PUBLIC_BASE_URL=https://<your-r2-public-url>/
# S3 endpoint override for S3-compatible stores such as MinIO (enables path-style
# addressing). Must stay unset for Cloudflare R2: the endpoint is derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=http://minio:9000
 
# Restore Execution Timeout (milliseconds)
# Defaults to 1800000 (30 minutes) to support large dumps up to 5 GB.
RESTORE_TIMEOUT_MS=1800000

# Restore: lock wait (milliseconds)
# How long a restore waits for each lock held by another session on the
# target's tables before giving up and leaving the target unchanged. The
# target's own queries on those tables wait too while it does. PostgreSQL cancels
# the pg_restore statement that has waited this long, which rolls the restore
# back; MySQL applies it to each step of the final swap, in whole seconds.
# Defaults to 30000 (30 seconds), from 1000 to 31536000000.
RESTORE_LOCK_WAIT_TIMEOUT_MS=30000

# Backup Execution Timeout (milliseconds)
# Defaults to 1800000 (30 minutes) to support massive database dumps.
BACKUP_TIMEOUT_MS=1800000

# Redis & BullMQ Queues
# In Docker Compose, use REDIS_HOST=redis. In Railway, REDIS_URL is auto-injected.
# localhost is only a development default: with NODE_ENV=production the API
# refuses to boot unless REDIS_URL or REDIS_HOST is set. Keep Redis on a private
# network; if it is reachable over a public network, use a rediss:// REDIS_URL
# or REDIS_TLS=true.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_TLS=false

