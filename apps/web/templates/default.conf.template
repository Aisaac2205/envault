# Resolver, upstream, CSP header name, and client-IP source are substituted at container
# start by the official nginx entrypoint (20-envsubst-on-templates.sh),
# scoped to an explicit allowlist by NGINX_ENVSUBST_FILTER (see Dockerfile)
# so nginx's own request-time $variables below are left untouched.
# NGINX_LOCAL_RESOLVERS itself comes from another built-in entrypoint
# script, 15-local-resolvers.envsh, gated behind NGINX_ENTRYPOINT_LOCAL_RESOLVERS.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers for SPA, proxied API responses, and SSE. Locations
    # declaring cache headers include this snippet again because nginx's
    # add_header inheritance stops at the first child add_header directive.
    include /etc/nginx/conf.d/security-headers.inc;

    # Gzip compression (text/html is gzipped by default in nginx core).
    gzip on;
    gzip_types application/javascript text/css application/json image/svg+xml;
    gzip_min_length 256;
    gzip_vary on;

    # SSE progress streams (restore and backup jobs) — no buffering, or
    # events queue up and never reach the client until the response ends,
    # and a long read timeout so a slow job does not cut its stream at 60s.
    # Declared before the general /api/ block: nginx always prefers a
    # matching regex location over a prefix match, regardless of source order.
    location ~ ^/api/(restores|backups)/[^/]+/stream$ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Railway mode trusts the edge-overwritten X-Real-IP; direct mode
        # ignores forwarding headers and uses nginx's TCP peer. The entrypoint
        # selects and validates CLIENT_IP_SOURCE before envsubst runs.
        proxy_set_header X-Real-IP ${CLIENT_IP_SOURCE};
        proxy_set_header X-Forwarded-For ${CLIENT_IP_SOURCE};
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Domain + auth API. proxy_pass targets an nginx variable (not a bare
    # hostname) so resolution happens per-request via the `resolver` above
    # instead of once at config load — a literal hostname here is what
    # made this proxy fail at startup before (see deployment-railway.md).
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP ${CLIENT_IP_SOURCE};
        proxy_set_header X-Forwarded-For ${CLIENT_IP_SOURCE};
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 20m;
        proxy_read_timeout 60s;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Do not cache index.html — always fetch latest
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Cache hashed assets aggressively (js, css with content hash in filename)
    location ~* \.(js|css)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Cache other static assets
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
