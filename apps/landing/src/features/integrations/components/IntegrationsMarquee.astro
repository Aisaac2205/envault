---
interface Props {
  locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;
const isEn = locale === "en";

const technologies = [
  {
    name: "PostgreSQL 16+",
    subtitle: isEn ? "Control Plane & Targets" : "Plano de Control y Destinos",
    icon: "/tech-icons/postgresql.svg",
    invert: false,
  },
  {
    name: "MySQL 8+",
    subtitle: isEn ? "Target DB Engine" : "Motor de Base de Datos",
    icon: "/tech-icons/mysql.svg",
    invert: false,
  },
  {
    name: "Cloudflare R2",
    subtitle: isEn ? "Zero-Egress Object Storage" : "Storage S3 Sin Egress Fees",
    icon: "/tech-icons/cloudflare.svg",
    invert: false,
  },
  {
    name: "AWS S3",
    subtitle: isEn ? "Amazon S3 Storage" : "Almacenamiento S3",
    icon: "/tech-icons/aws-s3.svg",
    invert: false,
  },
  {
    name: "Local Storage / NFS",
    subtitle: isEn ? "Air-Gapped Private Volumes" : "Volúmenes Privados On-Prem",
    icon: "/tech-icons/local-storage.svg",
    invert: false,
  },
];

const heading = isEn
  ? "Native compatibility with enterprise database engines and cloud storage"
  : "Compatibilidad nativa con motores de bases de datos empresariales y almacenamiento en la nube";

const label = isEn ? "Supported database engines and infrastructure" : "Motores de base de datos e infraestructura";
---

<section
  class="py-12 sm:py-16 border-y border-white/[0.08] bg-black overflow-hidden select-none"
  aria-label={label}
>
  <div class="max-w-7xl mx-auto px-6 mb-8 sm:mb-10 text-center">
    <p class="text-sm font-medium text-zinc-400 font-sans">{heading}</p>
  </div>

  <div
    class="marquee-wrapper relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
  >
    {
      [0, 1].map((track) => (
        <div
          class="marquee-track flex items-center py-2 shrink-0"
          aria-hidden={track === 1 ? "true" : undefined}
        >
          {technologies.map((tech) => (
            <div class="flex items-center gap-3 sm:gap-4 mx-5 sm:mx-8 group cursor-default shrink-0">
              <img
                src={tech.icon}
                alt=""
                aria-hidden="true"
                width="48"
                height="48"
                class={`size-8 sm:size-10 lg:size-11 object-contain opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-200 ${
                  tech.invert ? "brightness-0 invert" : ""
                }`}
                loading="lazy"
              />
              <span class="text-sm sm:text-base font-medium text-zinc-300 group-hover:text-white transition-colors font-sans whitespace-nowrap">
                {tech.name}
              </span>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .marquee-wrapper {
    display: flex;
    overflow: hidden;
    user-select: none;
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    min-width: 100%;
    animation: scroll-seamless 38s linear infinite;
    will-change: transform;
  }

  @keyframes scroll-seamless {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-wrapper {
      mask-image: none;
    }

    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }

    .marquee-track[aria-hidden="true"] {
      display: none;
    }
  }
</style>
