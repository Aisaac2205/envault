---
import { Copy, Check } from '@phosphor-icons/react';
import { highlight, TOKEN_CLASSES } from '../lib/highlight';
import type { CodeGroupVariant } from '../content/types';

interface Props {
  label: string;
  variants: CodeGroupVariant[];
  copyLabel: string;
  copiedLabel: string;
}

const { label, variants, copyLabel, copiedLabel } = Astro.props;
const groupId = `code-group-${crypto.randomUUID()}`;
---

<div class="rounded-xl border border-border bg-bg-subtle overflow-hidden" data-code-group>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border bg-bg-elevated px-2 py-1.5 sm:px-3">
    <div role="tablist" aria-label={label} class="flex min-w-0 flex-wrap gap-1">
      {
        variants.map((variant, index) => (
          <button
            type="button"
            role="tab"
            id={`${groupId}-tab-${index}`}
            aria-selected={index === 0}
            aria-controls={`${groupId}-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-group-tab
            class="rounded-md px-2.5 py-1 text-[11px] font-medium text-fg-muted transition-colors hover:text-fg aria-selected:bg-bg-hover aria-selected:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            {variant.label}
          </button>
        ))
      }
    </div>

    <button
      type="button"
      data-copy-button
      data-copy-label={copyLabel}
      data-copied-label={copiedLabel}
      aria-label={copyLabel}
      class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border bg-bg px-2 py-1 text-[11px] font-medium text-fg-muted transition-colors hover:bg-bg-hover hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <span data-icon-copy aria-hidden="true"><Copy size={14} /></span>
      <span data-icon-check aria-hidden="true" hidden><Check size={14} weight="bold" /></span>
      <span data-copy-label-text class="hidden sm:inline">{copyLabel}</span>
      <span class="sr-only" data-copy-status aria-live="polite"></span>
    </button>
  </div>

  {
    variants.map((variant, index) => (
      <div
        role="tabpanel"
        id={`${groupId}-panel-${index}`}
        aria-labelledby={`${groupId}-tab-${index}`}
        data-group-panel
        data-code={variant.code}
        hidden={index !== 0}
      >
        <pre class="overflow-x-auto p-4 font-mono text-xs sm:text-sm leading-relaxed">
          <code>
            {highlight(variant.code, variant.language).map((token) => (
              <span class={TOKEN_CLASSES[token.kind]}>{token.value}</span>
            ))}
          </code>
        </pre>
      </div>
    ))
  }
</div>
