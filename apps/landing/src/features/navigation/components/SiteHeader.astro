---
import type { Locale } from '../../i18n/types';
import GithubStarButton from './GithubStarButton.astro';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const isEn = locale === 'en';
const homeHref = isEn ? '/en' : '/';
const languageHref = altHref ?? (isEn ? '/' : '/en');
---

<header
  data-site-header
  class="fixed top-0 left-0 right-0 w-full z-50 transition-all duration-300 bg-transparent border-b border-transparent"
>
  <nav class="max-w-7xl w-full mx-auto px-6 py-4 flex items-center justify-between">
    {/* Only the official logo */}
    <a href={homeHref} class="flex h-9 items-center -mx-2 px-2 group" aria-label="EnVault Home">
      <img
        src="/logo.svg"
        alt="EnVault"
        width="15"
        height="16"
        class="h-3.5 sm:h-4 w-auto object-contain transition-transform group-hover:scale-105"
      />
    </a>

    {/*
      Right actions grouped in one translucent bar: language switch | docs | GitHub star.
      Without backdrop-filter support the fill is more opaque so the text keeps its contrast.
    */}
    <div class="flex h-9 shrink-0 items-stretch gap-0.5 rounded-lg border border-white/10 bg-black/80 p-0.5 supports-[backdrop-filter]:bg-black/45 supports-[backdrop-filter]:backdrop-blur-md">
      {/* Language switcher */}
      <a
        href={languageHref}
        class="inline-flex items-center gap-2 rounded-md px-2.5 text-xs text-zinc-100 hover:bg-white/10 hover:text-white cursor-pointer select-none motion-safe:transition-[background-color,color,scale] motion-safe:duration-150 motion-safe:ease-out motion-safe:active:scale-[0.98]"
        title={isEn ? 'Cambiar a Español' : 'Switch to English'}
        aria-label={isEn ? 'Cambiar a Español' : 'Switch to English'}
      >
        <img
          src="/traducir.png"
          alt=""
          aria-hidden="true"
          class="size-4 object-contain invert"
        />
        <span class="font-mono text-xs font-semibold">{isEn ? 'ES' : 'EN'}</span>
      </a>

      <span class="h-4 w-px self-center bg-white/10" aria-hidden="true"></span>

      {/* Docs link (in-app docs, same label in both languages) */}
      <a
        href={isEn ? '/en/docs' : '/docs'}
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md px-2.5 font-sans text-xs font-medium text-zinc-100 hover:bg-white/10 hover:text-white cursor-pointer motion-safe:transition-[background-color,color,scale] motion-safe:duration-150 motion-safe:ease-out motion-safe:active:scale-[0.98]"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <span class="sr-only sm:not-sr-only">Docs</span>
      </a>

      <span class="h-4 w-px self-center bg-white/10" aria-hidden="true"></span>

      {/* GitHub star: the repository link, with the star count once it reaches the visibility threshold */}
      <GithubStarButton locale={locale} />
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const updateHeader = () => {
      const isScrolled = window.scrollY > 40;
      if (isScrolled) {
        header.classList.add('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.remove('bg-transparent', 'border-transparent');
      } else {
        header.classList.remove('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.add('bg-transparent', 'border-transparent');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
</script>
