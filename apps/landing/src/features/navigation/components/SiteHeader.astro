---
import type { Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const isEn = locale === 'en';
const homeHref = isEn ? '/en' : '/';
const languageHref = altHref ?? (isEn ? '/' : '/en');
---

<header
  data-site-header
  class="fixed top-0 left-0 right-0 w-full z-50 transition-all duration-300 bg-transparent border-b border-transparent"
>
  <nav class="max-w-7xl w-full mx-auto px-6 py-4 flex items-center justify-between">
    {/* Only the official logo */}
    <a href={homeHref} class="flex items-center group" aria-label="EnVault Home">
      <img
        src="/logo.png"
        alt="EnVault"
        width="34"
        height="34"
        class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105"
      />
    </a>

    {/* Right actions: Language toggle with traducir.png & GitHub Repository */}
    <div class="flex items-center gap-3">
      {/* Language Switcher with traducir.png */}
      <a
        href={languageHref}
        class="flex items-center gap-2 px-2 py-1.5 text-xs text-zinc-300 hover:text-white transition-colors cursor-pointer select-none active:scale-[0.98]"
        title={isEn ? 'Cambiar a Español' : 'Switch to English'}
        aria-label={isEn ? 'Cambiar a Español' : 'Switch to English'}
      >
        <img
          src="/traducir.png"
          alt=""
          aria-hidden="true"
          class="size-4 object-contain invert opacity-90"
        />
        <span class="font-mono text-xs font-semibold text-zinc-200">{isEn ? 'ES' : 'EN'}</span>
      </a>

      {/* GitHub Repository Button */}
      <a
        href="https://github.com/Aisaac2205/envault"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors cursor-pointer font-sans h-9 px-2 text-xs text-zinc-300 hover:text-white active:scale-[0.98]"
      >
        <svg
          class="size-4 fill-current"
          role="img"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <span class="hidden sm:inline">{isEn ? 'Repository' : 'Repositorio'}</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const updateHeader = () => {
      const isScrolled = window.scrollY > 40;
      if (isScrolled) {
        header.classList.add('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.remove('bg-transparent', 'border-transparent');
      } else {
        header.classList.remove('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.add('bg-transparent', 'border-transparent');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
</script>
