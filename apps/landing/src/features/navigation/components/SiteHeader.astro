---
import type { Locale } from '../../i18n/types';
import GithubStarButton from './GithubStarButton.astro';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const isEn = locale === 'en';
const homeHref = isEn ? '/en' : '/';
const languageHref = altHref ?? (isEn ? '/' : '/en');
---

<header
  data-site-header
  class="fixed top-0 left-0 right-0 w-full z-50 transition-all duration-300 bg-transparent border-b border-transparent"
>
  <nav class="max-w-7xl w-full mx-auto px-6 py-4 flex items-center justify-between">
    {/* Only the official logo */}
    <a href={homeHref} class="flex items-center group" aria-label="EnVault Home">
      <img
        src="/logo.png"
        alt="EnVault"
        width="34"
        height="34"
        class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105"
      />
    </a>

    {/* Right actions: Language toggle with traducir.png & GitHub Repository */}
    <div class="flex items-center gap-3">
      {/* Language Switcher with traducir.png */}
      <a
        href={languageHref}
        class="flex items-center gap-2 px-2 py-1.5 text-xs text-zinc-300 hover:text-white transition-colors cursor-pointer select-none active:scale-[0.98]"
        title={isEn ? 'Cambiar a Español' : 'Switch to English'}
        aria-label={isEn ? 'Cambiar a Español' : 'Switch to English'}
      >
        <img
          src="/traducir.png"
          alt=""
          aria-hidden="true"
          class="size-4 object-contain invert opacity-90"
        />
        <span class="font-mono text-xs font-semibold text-zinc-200">{isEn ? 'ES' : 'EN'}</span>
      </a>

      {/* Docs Button (in-app docs, same label in both languages) */}
      <a
        href={isEn ? '/en/docs' : '/docs'}
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors cursor-pointer font-sans h-9 px-2 text-xs text-zinc-300 hover:text-white active:scale-[0.98]"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <span class="hidden sm:inline">Docs</span>
      </a>

      {/* GitHub star button: the repository link, with the star count once it reaches the visibility threshold */}
      <GithubStarButton locale={locale} />
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const updateHeader = () => {
      const isScrolled = window.scrollY > 40;
      if (isScrolled) {
        header.classList.add('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.remove('bg-transparent', 'border-transparent');
      } else {
        header.classList.remove('bg-zinc-950/85', 'backdrop-blur-xl', 'border-white/[0.08]');
        header.classList.add('bg-transparent', 'border-transparent');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
</script>
