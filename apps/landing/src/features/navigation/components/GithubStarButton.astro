---
import type { Locale } from '../../i18n/types';
import { getDictionary } from '../../i18n/get-dictionary';
import { REPOSITORY_URL, formatStarCount, getStarCount, visibleStarCount } from '../../github/stars';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).githubStar;
const stars = visibleStarCount(await getStarCount());
---

{/*
  A segment of the header's action bar, with a resting fill so it reads as the primary action.
  Below `sm` it collapses to the octocat and the heart; the label stays in the accessible name.
*/}
<a
  href={REPOSITORY_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-md bg-white/5 px-2.5 font-sans text-xs font-medium text-white hover:bg-white/10 motion-safe:transition-[background-color,scale] motion-safe:duration-150 motion-safe:ease-out motion-safe:active:scale-[0.98]"
>
  <svg
    class="size-4 shrink-0 fill-current"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
  </svg>
  <span class="sr-only sm:not-sr-only">{t.label}</span>
  {
    stars !== null && (
      <span class="tabular-nums text-zinc-300">
        {' '}{formatStarCount(stars, locale)}<span class="sr-only"> {t.starsLabel}</span>
      </span>
    )
  }
  <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="#ff4d6d" aria-hidden="true">
    <path d="M12 21.35 10.55 20.03C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.54L12 21.35Z" />
  </svg>
  <span class="sr-only"> {t.opensInNewTab}</span>
</a>
