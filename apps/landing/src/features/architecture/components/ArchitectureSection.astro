---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { Locale } from '../../i18n/types';
import dashboardEs from '../../../assets/dashboard/dash-es.png';
import dashboardEn from '../../../assets/dashboard/dash-en.png';
import dashboardMobileEs from '../../../assets/dashboard/dashmobile-es.png';
import dashboardMobileEn from '../../../assets/dashboard/dashmobile-en.png';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const isEn = locale === 'en';

const title = isEn
  ? 'Complete Traceability & Centralized Control'
  : 'Trazabilidad Total y Control Centralizado';

const subtitle = isEn
  ? 'Real-time monitoring of every backup job, immutable audit trails, and restore drills ensuring zero data loss across all database clusters.'
  : 'Monitoreo en tiempo real del estado de cada copia de seguridad, registros de auditoría inmutables y simulaciones de restauración para garantizar cero pérdida de datos en todos tus clusters.';

const screenshotAlt = isEn
  ? 'EnVault Management dashboard showing the success rate, this week’s backups, how long each backup took, and the latest restore'
  : 'Panel de EnVault Management con la tasa de éxito, las copias de seguridad de la semana, cuánto tardó cada una y la última restauración';

const screenshots: Record<Locale, { desktop: ImageMetadata; mobile: ImageMetadata }> = {
  es: { desktop: dashboardEs, mobile: dashboardMobileEs },
  en: { desktop: dashboardEn, mobile: dashboardMobileEn },
};
const { desktop, mobile } = screenshots[locale];

// Art direction: the desktop capture from Tailwind's `md` breakpoint up, the phone mockup below it.
// Every <source> carries its own width and height so neither aspect ratio shifts the layout.
const desktopMedia = '(min-width: 48rem)';
const desktopSizes = '(min-width: 80rem) 77rem, calc(100vw - 3rem)';
const mobileSizes = '18rem';

const [desktopAvif, desktopWebp, mobileAvif, mobileWebp] = await Promise.all([
  getImage({ src: desktop, format: 'avif', widths: [800, 1200, desktop.width] }),
  getImage({ src: desktop, format: 'webp', widths: [800, 1200, desktop.width] }),
  getImage({ src: mobile, format: 'avif', widths: [576, mobile.width] }),
  getImage({ src: mobile, format: 'webp', widths: [576, mobile.width] }),
]);
---

<section id="architecture" class="py-24 px-6 max-w-7xl mx-auto font-sans" aria-labelledby="architecture-heading">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <h2 id="architecture-heading" class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-white mb-4">
      {title}
    </h2>
    <p class="text-base text-zinc-400 leading-relaxed">
      {subtitle}
    </p>
  </div>

  {/* The phone capture brings its own frame, so the card treatment only wraps the desktop capture */}
  <div class="mb-12 md:rounded-2xl md:border md:border-white/10 md:overflow-hidden md:shadow-2xl">
    <picture>
      <source
        media={desktopMedia}
        type="image/avif"
        srcset={desktopAvif.srcSet.attribute}
        sizes={desktopSizes}
        width={desktopAvif.attributes.width}
        height={desktopAvif.attributes.height}
      />
      <source
        media={desktopMedia}
        type="image/webp"
        srcset={desktopWebp.srcSet.attribute}
        sizes={desktopSizes}
        width={desktopWebp.attributes.width}
        height={desktopWebp.attributes.height}
      />
      <source
        type="image/avif"
        srcset={mobileAvif.srcSet.attribute}
        sizes={mobileSizes}
        width={mobileAvif.attributes.width}
        height={mobileAvif.attributes.height}
      />
      <img
        src={mobileWebp.src}
        srcset={mobileWebp.srcSet.attribute}
        sizes={mobileSizes}
        alt={screenshotAlt}
        width={mobileWebp.attributes.width}
        height={mobileWebp.attributes.height}
        class="block mx-auto w-full max-w-72 h-auto md:max-w-none"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
</section>
