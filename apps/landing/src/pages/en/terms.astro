---
import Landing from "../../layouts/Landing.astro";
import Footer from "../../features/navigation/components/Footer.astro";
import SiteHeader from "../../features/navigation/components/SiteHeader.astro";

const locale = "en";
---

<Landing locale={locale} title="Terms of Service — EnVault Management" description="Terms of service and software licensing conditions for EnVault Management.">
  <SiteHeader locale={locale} altHref="/terms" />

  <main id="main-content" class="max-w-4xl mx-auto px-6 pt-28 pb-16 flex-grow font-sans text-zinc-300 leading-relaxed space-y-12">
    <header class="space-y-3 pb-8 border-b border-white/[0.08]">
      <p class="text-xs text-zinc-500 uppercase tracking-wider font-mono">Last updated: September 24, 2026</p>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-white">Terms of Service</h1>
      <p class="text-base text-zinc-400">
        General conditions and operational guidelines governing the use of EnVault Management software.
      </p>
    </header>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-white tracking-tight">1. Software Licensing & Deployment</h2>
      <p class="text-sm text-zinc-400">
        EnVault Management is licensed for self-hosted deployment across on-premise, cloud, or air-gapped infrastructure under the PolyForm Noncommercial 1.0.0 license or negotiated enterprise agreements.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-white tracking-tight">2. Responsibility for Database Credentials & Restores</h2>
      <p class="text-sm text-zinc-400">
        You retain sole responsibility for securing database connection credentials, encryption keys, and S3 / Cloudflare R2 bucket lifecycle policies. Performing routine non-destructive dry-run restore tests is strongly recommended.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-white tracking-tight">3. Enterprise Support & High-Availability SLA</h2>
      <p class="text-sm text-zinc-400">
        For enterprise deployments requiring guaranteed response times, mission-critical architectural reviews, or custom driver integrations, refer to the documentation and GitHub issues channel.
      </p>
    </section>
  </main>

  <Footer locale={locale} />
</Landing>
