---
import Landing from "../../layouts/Landing.astro";
import SiteHeader from "../../features/navigation/components/SiteHeader.astro";
import HeroSection from "../../features/hero/components/HeroSection.astro";
import BackupProcessSection from "../../features/process/components/BackupProcessSection.astro";
import FeaturesGrid from "../../features/features-grid/components/FeaturesGrid.astro";
import { InstallSection } from "../../features/install/components/InstallSection";
import CtaBanner from "../../features/navigation/components/CtaBanner.astro";
import Footer from "../../features/navigation/components/Footer.astro";
import { getDictionary } from "../../features/i18n/get-dictionary";

const locale = "en";
const dict = getDictionary(locale);
---

<Landing locale={locale}>
  <SiteHeader locale={locale} />

  <div id="main-content" class="flex-grow">
    {/* Hero: headline, install and docs actions, and the localized dashboard capture */}
    <HeroSection locale={locale} />

    {/* Real Core Capabilities & Bento Grid */}
    <FeaturesGrid locale={locale} />

    {/* 4-Step Backup Process: How to back up PostgreSQL and MySQL */}
    <BackupProcessSection locale={locale} />

    {/* Interactive Install Section: How to install (Linux, Windows, Docker, Compose) */}
    <InstallSection client:visible t={dict.install} locale={locale} />

    {/* Bottom Call to Action */}
    <CtaBanner locale={locale} />
  </div>

  {/* Footer */}
  <Footer locale={locale} />
</Landing>
