# Forzar LF en archivos que viven dentro de containers Linux,
# independiente del SO del dev. Sin esto, devs en Windows hacen
# checkout con CRLF y los scripts fallan con exit 127 ("not found")
# porque Linux interpreta el `\r` final de la shebang como parte
# del path al intérprete.
*.sh           text eol=lf
*.envsh        text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf
docker-compose*.yml text eol=lf
nginx.conf     text eol=lf
*.conf.template text eol=lf
# The CSP in apps/web/nginx/security-headers.conf pins the inline theme
# script by its sha256 hash, which is computed over LF bytes. A CRLF checkout
# changes the hash and the browser blocks the script.
*.html         text eol=lf
.env.example   text eol=lf
